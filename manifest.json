{
  "schemaVersion": 1,
  "id": "io.github.s3pp3ku.keybindz",
  "name": "KeyBindz",
  "version": "0.1.0",
  "author": "s3pp3ku",
  "license": "MIT",
  "description": "A theme-aware keyboard shortcut guide with a frosted physical keyboard overlay.",
  "kinds": [
    "bar-widget",
    "service"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "KeyBindz",
    "category": "Learning",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "guideDelayMs": 500,
      "guideTopOffset": 0,
      "guideView": "keyboard",
      "showInFullscreen": false,
      "guideSuperEnabled": true,
      "guideShiftEnabled": false,
      "guideCtrlEnabled": true,
      "guideAltEnabled": false
    },
    "schema": [
      {
        "key": "guideView",
        "type": "string",
        "label": "Guide view (keyboard or cards)"
      },
      {
        "key": "guideDelayMs",
        "type": "integer",
        "label": "Super Guide delay (ms)"
      },
      {
        "key": "guideTopOffset",
        "type": "integer",
        "label": "Guide top offset (px)"
      },
      {
        "key": "showInFullscreen",
        "type": "boolean",
        "label": "Show over fullscreen windows"
      },
      {
        "key": "guideSuperEnabled",
        "type": "boolean",
        "label": "Show Super guide"
      },
      {
        "key": "guideShiftEnabled",
        "type": "boolean",
        "label": "Show Shift guide"
      },
      {
        "key": "guideCtrlEnabled",
        "type": "boolean",
        "label": "Show Ctrl guide"
      },
      {
        "key": "guideAltEnabled",
        "type": "boolean",
        "label": "Show Alt guide"
      }
    ]
  }
}
